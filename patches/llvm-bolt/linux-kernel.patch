+// Preserve instructions that the x86 kernel patches directly at runtime.
+Error LinuxKernelRewriter::protectX86PatchSites() {
+  for (BinarySection &Section : BC.allocatableSections()) {
+    StringRef Name = Section.getName();
+    const bool Track = Name == ".call_sites" || Name == ".return_sites";
+    if (!Track && Name != ".retpoline_sites" && Name != ".ibt_endbr_seal" &&
+        Name != ".cfi_sites" && Name != "__kcfi_traps" &&
+        !Name.starts_with("runtime_ptr_") &&
+        !Name.starts_with("runtime_shift_") &&
+        !Name.starts_with("runtime_mask_"))
+      continue;
+
+    if (Section.getSize() % 4)
+      return createStringError(errc::executable_format_error,
+                               "invalid patch-site table %s", Name.str().c_str());
+    AddressExtractor AE(Section.getContents(), Section.getAddress(),
+                        BC.AsmInfo->isLittleEndian(),
+                        BC.AsmInfo->getCodePointerSize());
+    AddressExtractor::Cursor Cursor(0);
+    while (Cursor.tell() < Section.getSize()) {
+      const uint64_t Offset = Cursor.tell();
+      const uint64_t IP = AE.getPCRelAddress32(Cursor);
+      if (!Cursor)
+        return Cursor.takeError();
+      BinaryFunction *BF = BC.getBinaryFunctionContainingAddress(IP);
+      if (!BF || !BC.shouldEmit(*BF))
+        continue;
+      MCInst *Inst = BF->getInstructionAtOffset(IP - BF->getAddress());
+      if (!Track || !Inst) {
+        BF->setIgnored();
+        continue;
+      }
+      MCSymbol *Label =
+          BC.MIB->getOrCreateInstLabel(*Inst, "__LKPatch_", BC.Ctx.get());
+      Fixups.push_back({Section, Offset, *BF, *Label, /*IsPCRelative*/ true});
+    }
+  }
+
+  // ftrace's table is embedded in .init.data. Its pointers may designate an
+  // instruction after ENDBR rather than the function's entry point.
+  const BinaryData *Start = BC.getBinaryDataByName("__start_mcount_loc");
+  const BinaryData *End = BC.getBinaryDataByName("__stop_mcount_loc");
+  if (!Start || !End || Start->getAddress() == End->getAddress())
+    return Error::success();
+  auto Section = BC.getSectionForAddress(Start->getAddress());
+  if (!Section || !Section->containsAddress(End->getAddress() - 1))
+    return createStringError(errc::executable_format_error,
+                             "invalid ftrace table");
+  const uint64_t PointerSize = BC.AsmInfo->getCodePointerSize();
+  for (uint64_t Address = Start->getAddress(); Address < End->getAddress();
+       Address += PointerSize) {
+    auto IP = BC.getUnsignedValueAtAddress(Address, PointerSize);
+    if (!IP)
+      return errorCodeToError(IP.getError());
+    BinaryFunction *BF = BC.getBinaryFunctionContainingAddress(*IP);
+    if (!BF || !BC.shouldEmit(*BF))
+      continue;
+    MCInst *Inst = BF->getInstructionAtOffset(*IP - BF->getAddress());
+    if (!Inst) {
+      BF->setIgnored();
+      continue;
+    }
+    MCSymbol *Label =
+        BC.MIB->getOrCreateInstLabel(*Inst, "__LKFentry_", BC.Ctx.get());
+    Fixups.push_back({*Section, Address - Section->getAddress(), *BF, *Label,
+                      /*IsPCRelative*/ false});
+  }
+  return Error::success();
+}
